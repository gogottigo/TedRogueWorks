---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BakeryBotPreview from '../components/BakeryBotPreview.astro';
import ProfistalPreview from '../components/ProfistalPreview.astro';
import { sitePath } from '../i18n/paths';
---

<SiteLayout title="TRW Studio — сайты для бизнеса" description="Проектируем и разрабатываем современные сайты для бизнеса: от лендингов до корпоративных решений." locale="ru">
  <div class="studio-home">
    <section class="studio-hero" aria-labelledby="hero-title">
      <div class="hero-topline"><span>НЕЗАВИСИМАЯ DIGITAL-СТУДИЯ</span><span>РАБОТАЕМ ОНЛАЙН ПО ВСЕЙ РОССИИ</span></div>
      <p class="hero-kicker"><i aria-hidden="true"></i> ДИЗАЙН · РАЗРАБОТКА · ПОДДЕРЖКА</p>
      <h1 id="hero-title">Создаём сайты,<br />которые работают<br /><em>на ваш бизнес.</em></h1>
      <div class="hero-bottom"><p>Проектируем и разрабатываем современные сайты — от лаконичных лендингов до полноценных цифровых решений.</p><div class="hero-actions"><a class="button-link" href={sitePath('/contact/')}>Обсудить проект <span aria-hidden="true">↗</span></a><a class="quiet-link" href={sitePath('/projects/')}>Наши работы <span aria-hidden="true">↓</span></a></div></div>
      <span class="hero-index">TRW / 001</span>
    </section>

    <section class="work-section ruled" id="projects" aria-labelledby="work-title">
      <div class="section-head"><p class="index-label">01 / РАБОТЫ</p><h2 id="work-title">Избранные проекты</h2><a href={sitePath('/projects/')}>Все проекты ↗</a></div>
      <ProjectCard index="02" label="КЕЙС" type="Telegram-бот" client="Пекарня Чудес" title="Пекарня Чудес." description="Telegram-бот для пекарни, разработанный для взаимодействия с клиентами." href={sitePath('/projects/pekarnya-chudes/')} linkLabel="Подробный кейс" id="home-pekarnya-title">
        <BakeryBotPreview slot="preview" locale="ru" />
      </ProjectCard>
      <ProjectCard index="01" label="КЕЙС" type="Веб-сайт · Металлоконструкции" client="ПрофиСталь 14 — Якутск" title="ПрофиСталь 14." description="Сайт для мастерской металлоконструкций в Якутске, представляющий направления продукции и помогающий посетителям сориентироваться в категориях." href={sitePath('/projects/profistal14/')} linkLabel="Подробный кейс" id="home-profistal-title">
        <ProfistalPreview slot="preview" locale="ru" />
      </ProjectCard>
    </section>

    <section class="services-section ruled" id="services" aria-labelledby="services-title">
      <div class="section-head"><p class="index-label">02 / УСЛУГИ</p><h2 id="services-title">Цифровая основа<br />для роста бизнеса.</h2><span></span></div>
      <div class="service-list">
        <article><span>01</span><div><h3>Лендинги и страницы продукта</h3><p>Помогаем ясно рассказать о предложении и привести посетителя к следующему шагу.</p></div><b aria-hidden="true">↗</b></article>
        <article><span>02</span><div><h3>Корпоративные сайты</h3><p>Собираем услуги, информацию о компании и полезные материалы в понятную структуру.</p></div><b aria-hidden="true">↗</b></article>
        <article><span>03</span><div><h3>Интернет-магазины и интеграции</h3><p>Обсуждаем нужные функции и подбираем реализацию под задачу и технический контекст.</p></div><b aria-hidden="true">↗</b></article>
        <article><span>04</span><div><h3>Поддержка и развитие</h3><p>Помогаем улучшать существующий сайт, обновлять содержание и развивать его дальше.</p></div><b aria-hidden="true">↗</b></article>
        <article><span>05</span><div><h3>Боты для Telegram и MAX</h3><p>Разрабатываем ботов для автоматизации общения с клиентами, приёма заявок, обработки заказов и выполнения рутинных задач. Интегрируем ботов с сайтами, таблицами и внешними сервисами, когда это необходимо.</p><ul><li>Приём заявок и обратной связи</li><li>Уведомления и автоматизация рутинных процессов</li><li>Каталоги товаров и оформление заказов</li><li>Интеграции с сайтами, API и другими сервисами</li></ul></div><b aria-hidden="true">↗</b></article>
      </div>
    </section>

    <section class="studio-section ruled" id="studio" aria-labelledby="studio-title">
      <p class="index-label">03 / СТУДИЯ</p><div><h2 id="studio-title">Независимая студия.<br /><em>Внимание к деталям.</em></h2><p>TRW Studio — независимая digital-студия. Мы проектируем и разрабатываем сайты для бизнеса, внимательно относимся к содержанию, визуальной системе и тому, как сайт работает на разных устройствах.</p><a href={sitePath('/about/')}>Больше о студии ↗</a></div>
    </section>

    <section class="process-section ruled" aria-labelledby="process-title">
      <div class="section-head"><p class="index-label">04 / ПРОЦЕСС</p><h2 id="process-title">От задачи<br />до публикации.</h2><span></span></div>
      <ol class="process-list"><li><span>01</span><h3>Обсуждение задачи</h3><p>Уточняем цели, аудиторию и содержание проекта.</p></li><li><span>02</span><h3>Проектирование</h3><p>Собираем структуру и согласуем направление.</p></li><li><span>03</span><h3>Разработка и проверка</h3><p>Реализуем сайт и проверяем его работу на устройствах.</p></li><li><span>04</span><h3>Публикация и передача</h3><p>Помогаем запустить проект и передаём необходимые материалы.</p></li></ol>
    </section>

    <section class="contact-section ruled" id="contact" aria-labelledby="contact-title">
      <p class="index-label">05 / КОНТАКТЫ</p><div class="contact-main"><h2 id="contact-title">Расскажите<br /><em>о своей задаче.</em></h2><p>Заполните форму — мы подготовим сообщение для Telegram. Перед отправкой его можно проверить и изменить.</p>
        <form id="project-form"><label>Имя<input name="name" autocomplete="name" required /></label><label>Как с вами связаться?<input name="reply" autocomplete="email" required /></label><label class="message-field">Коротко о проекте<textarea name="message" rows="4" required></textarea></label><button class="button-link" type="submit">Продолжить в Telegram <span aria-hidden="true">↗</span></button><p class="form-note" id="form-note" aria-live="polite">Сообщение откроется в Telegram; отправить его нужно будет вручную.</p></form>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .studio-home { --line:var(--rule); }
  .ruled { border-top:1px solid var(--line); }
  .index-label,.hero-topline,.hero-kicker,.hero-index,.visual-meta,.visual-caption { font-family:"SFMono-Regular",Consolas,monospace; font-size:.64rem; letter-spacing:.075em; }
  .studio-hero { position:relative; padding:20px 0 62px; display:flex; flex-direction:column; justify-content:flex-start; }
  .hero-topline { display:flex; justify-content:space-between; gap:20px; color:var(--muted); }
  .hero-kicker { display:flex; align-items:center; gap:10px; margin:clamp(28px,4vw,48px) 0 22px; color:var(--cobalt); }
  .hero-kicker i { width:7px; height:7px; background:var(--cobalt); }
  .studio-hero h1 { max-width:1000px; margin:0 0 34px -.055em; font-size:clamp(3.2rem,7.6vw,6.8rem); font-weight:550; line-height:.9; letter-spacing:-.09em; }
  .studio-hero h1 em,.studio-section h2 em,.contact-main h2 em { color:var(--muted); font-style:normal; }
  .hero-bottom { display:flex; align-items:flex-end; justify-content:space-between; gap:30px; }
  .hero-bottom > p { max-width:440px; margin:0; color:var(--muted); font-size:clamp(1rem,1.6vw,1.2rem); line-height:1.7; }
  .hero-actions,.work-links { display:flex; flex-wrap:wrap; align-items:center; gap:14px 22px; }
  .button-link { display:inline-flex; align-items:center; justify-content:center; gap:24px; min-height:46px; padding:0 16px; border:1px solid var(--cobalt); background:var(--cobalt); color:white; font:inherit; font-size:.82rem; text-decoration:none; cursor:pointer; transition:background .18s,color .18s; }
  .button-link:hover { background:transparent; color:var(--cobalt); }
  .button-link:focus-visible,.quiet-link:focus-visible,.work-links a:focus-visible,.studio-section a:focus-visible { outline:2px solid var(--cobalt); outline-offset:4px; }
  .quiet-link,.work-links > a:not(.button-link),.studio-section a { color:var(--cobalt); font-size:.82rem; text-decoration:none; }
  .hero-index { position:absolute; right:0; bottom:20px; color:var(--muted); }
  .section-head { display:grid; grid-template-columns:minmax(120px,.55fr) minmax(0,1.45fr) auto; align-items:start; gap:24px; padding:30px 0; }
  .index-label { margin:5px 0 0; color:var(--cobalt); }
  .section-head h2,.studio-section h2,.contact-main h2 { margin:0; font-size:clamp(2.3rem,5.5vw,5rem); font-weight:540; line-height:.98; letter-spacing:-.075em; }
  .section-head > a { color:var(--cobalt); font-size:.78rem; text-decoration:none; }
  .work-section .project-case { padding-bottom:56px; }
  .visual-meta,.visual-caption { position:absolute; color:var(--muted); font-size:.59rem; }.visual-meta { top:16px; left:17px; }.visual-caption { right:17px; bottom:16px; }
  .service-list { padding:0 0 68px; }.service-list article { display:grid; grid-template-columns:70px minmax(0,1fr) 20px; gap:20px; align-items:start; padding:24px 0; border-top:1px solid var(--line); }.service-list article:last-child { border-bottom:1px solid var(--line); }.service-list article > span,.process-list > li > span { color:var(--cobalt); font: .68rem "SFMono-Regular",Consolas,monospace; }.service-list h3,.process-list h3 { margin:0; font-size:1.2rem; font-weight:520; letter-spacing:-.035em; }.service-list p,.process-list p { max-width:580px; margin:8px 0 0; color:var(--muted); font-size:.9rem; line-height:1.65; }.service-list ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px 22px; max-width:720px; margin:15px 0 0; padding:0; color:var(--muted); font-size:.82rem; line-height:1.55; list-style:none; }.service-list ul li::before { content:"— "; color:var(--cobalt); }.service-list b { color:var(--cobalt); font-weight:400; }
  .studio-section,.contact-section { display:grid; grid-template-columns:minmax(120px,.55fr) minmax(0,1.45fr); gap:24px; padding:clamp(60px,9vw,110px) 0; }.studio-section > div { max-width:820px; }.studio-section > div > p,.contact-main > p { max-width:610px; margin:24px 0; color:var(--muted); font-size:1rem; line-height:1.75; }.studio-section a { display:inline-block; margin-top:4px; border-bottom:1px solid var(--cobalt); padding-bottom:6px; }
  .process-list { grid-column:1/-1; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:20px; margin:14px 0 72px; padding:0; list-style:none; }.process-list li { min-height:155px; padding-top:15px; border-top:1px solid var(--line); }.process-list h3 { margin-top:24px; font-size:1rem; }.process-list p { font-size:.82rem; }
  .contact-main { max-width:850px; }.contact-main h2 { font-size:clamp(3rem,7vw,6rem); }.contact-main form { display:grid; grid-template-columns:1fr 1fr; gap:18px 20px; margin-top:35px; }.contact-main label { display:grid; gap:8px; font-size:.8rem; }.contact-main input,.contact-main textarea { width:100%; border:1px solid var(--line); border-radius:0; background:transparent; padding:12px; color:var(--ink); font:inherit; }.contact-main input:focus,.contact-main textarea:focus { outline:2px solid var(--cobalt); outline-offset:2px; }.message-field { grid-column:1/-1; }.contact-main button { justify-self:start; }.form-note { align-self:center; margin:0; color:var(--muted); font-size:.75rem; line-height:1.5; }
  @media(max-width:760px) { .studio-hero { padding:18px 0 60px; }.hero-kicker { margin-top:clamp(20px,5vw,34px); }.studio-hero h1 { font-size:clamp(3rem,10vw,5.2rem); }.hero-bottom { align-items:flex-start; flex-direction:column; }.section-head { grid-template-columns:1fr auto; gap:13px; }.section-head .index-label { grid-column:1/-1; }.section-head h2 { font-size:clamp(2.3rem,8vw,4rem); }.studio-section,.contact-section { grid-template-columns:1fr; gap:24px; }.process-list { grid-template-columns:1fr 1fr; margin-bottom:56px; } }
  @media(max-width:480px) { .hero-topline { gap:8px; font-size:.55rem; }.hero-topline span:last-child { text-align:right; }.studio-hero h1 { font-size:clamp(2.75rem,10.7vw,3.5rem); }.hero-actions { align-items:flex-start; flex-direction:column; }.service-list article { grid-template-columns:36px minmax(0,1fr) 16px; gap:12px; }.service-list h3 { font-size:1.05rem; }.service-list ul { grid-template-columns:1fr; }.process-list { grid-template-columns:1fr; gap:0; }.process-list li { min-height:0; padding:16px 0; }.process-list h3 { margin-top:12px; }.contact-main form { grid-template-columns:1fr; }.message-field { grid-column:auto; }.form-note { margin-top:-8px; }.visual-caption { font-size:.52rem; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#project-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const message = `Здравствуйте! Меня зовут ${data.get('name')}.\nСвязаться со мной: ${data.get('reply')}.\n\nО проекте:\n${data.get('message')}`;
    const shareUrl = new URL('https://t.me/share/url');
    shareUrl.searchParams.set('url', 'https://trwstudio.art/');
    shareUrl.searchParams.set('text', message);
    window.open(shareUrl.href, '_blank', 'noopener,noreferrer');
  });
</script>

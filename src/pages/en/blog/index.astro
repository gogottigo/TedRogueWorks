---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { sitePath } from '../../../i18n/paths';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<SiteLayout title="Blog — TRW Studio" description="Articles and notes about development." locale="en">
  <h1 class="text-5xl font-semibold tracking-tight">Blog</h1>
  <ul class="mt-10 grid gap-5 sm:grid-cols-2">
    {posts.map((post) => (
      <li class="journal-card border border-white/10 p-6">
        <time class="text-sm text-white/50" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US')}</time>
        <h2 class="mt-3 text-2xl font-medium"><a href={sitePath(`/en/blog/${post.data.slug}/`)}>{post.data.title}</a></h2>
        <p class="mt-3 text-white/65">{post.data.description}</p>
      </li>
    ))}
  </ul>
</SiteLayout>

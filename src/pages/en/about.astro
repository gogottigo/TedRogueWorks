---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { sitePath } from '../../i18n/paths';

const candidates = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const uniquePosts = new Map<string, (typeof candidates)[number]>();
for (const post of candidates) {
  if (!uniquePosts.has(post.data.translationKey)) uniquePosts.set(post.data.translationKey, post);
}
const posts = [...uniquePosts.values()].slice(0, 3);
---

<SiteLayout title="About — TedRogueWorks" description="A trail of projects, notes, and experiments." locale="en">
  <div class="operator-page">
    <header class="operator-meta">
      <p>FILE 001 <span>/ THE OPERATOR</span></p>
      <p class="operator-status"><i aria-hidden="true"></i> INDEPENDENTLY OPERATED</p>
    </header>

    <section class="operator-hero" aria-labelledby="operator-title">
      <div class="operator-copy">
        <p class="operator-subtitle reveal reveal-1">SOMEWHERE BETWEEN LOGIC AND CURIOSITY.</p>
        <h1 id="operator-title" class="operator-title">Not everything<br /><em>needs an explanation.</em></h1>
        <div class="operator-body reveal reveal-3">
          <p>I build things that work: websites, tools, small systems, and ideas that haven't found the right name yet.</p>
          <p>I'm interested in how things fit together — from a line of code to the infrastructure it runs on. I prefer figuring things out, testing assumptions, and leaving something tangible behind.</p>
          <p>This website isn't a complete account of who I am. Think of it as a trail of projects, notes, and experiments.</p>
        </div>
      </div>

      <figure class="operator-figure reveal-geometry" aria-label="Abstract geometric composition">
        <div class="operator-art-frame">
          <svg class="operator-art" viewBox="0 0 520 520" role="img" aria-labelledby="operator-art-title operator-art-desc">
            <title id="operator-art-title">A fragment of a system</title>
            <desc id="operator-art-desc">A cobalt form, circles, and coordinate lines on a grid.</desc>
            <defs>
              <pattern id="operator-grid" width="26" height="26" patternUnits="userSpaceOnUse">
                <path d="M 26 0 H 0 V 26" fill="none" stroke="currentColor" stroke-opacity=".13" stroke-width="1" />
              </pattern>
              <clipPath id="operator-clip"><rect width="520" height="520" /></clipPath>
            </defs>
            <g clip-path="url(#operator-clip)">
              <rect width="520" height="520" fill="url(#operator-grid)" />
              <path class="operator-axis" d="M 0 260 H 520 M 260 0 V 520" />
              <circle class="operator-ring operator-ring-a" cx="260" cy="260" r="186" />
              <circle class="operator-ring operator-ring-b" cx="260" cy="260" r="126" />
              <path class="operator-arc" d="M260 74 A186 186 0 0 1 446 260" />
              <path class="operator-arc operator-arc-alt" d="M260 134 A126 126 0 0 0 134 260" />
              <path class="operator-vector" d="M260 260 390 130 M390 130h76 M390 130V54" />
              <circle class="operator-core" cx="260" cy="260" r="49" />
              <circle class="operator-point" cx="260" cy="260" r="5" />
              <circle class="operator-point" cx="390" cy="130" r="5" />
              <path class="operator-tick" d="M73 385h65m-32-32v65M420 370h54m-27-27v54" />
            </g>
          </svg>
          <span class="art-label art-label-top">PLATE 001 <span>— OPEN SYSTEM</span></span>
          <span class="art-label art-label-side">R 186<br />AXIS 260</span>
          <span class="art-index">TRW / 001</span>
        </div>
        <figcaption><span>FIELD NOTES / 01</span><span>FORM IN PROGRESS</span></figcaption>
      </figure>
    </section>

    <section class="operator-journal" aria-labelledby="journal-title">
      <p class="section-index">02 <span>/ FROM THE JOURNAL</span></p>
      <div class="journal-content">
        <div class="journal-heading"><h2 id="journal-title">Latest dispatches</h2><a href={sitePath('/en/blog/')}>All posts <span aria-hidden="true">↗</span></a></div>
        {posts.length ? <ul class="journal-list">{posts.map((post) => (
          <li><a class="journal-row" href={sitePath(`/en/blog/${post.data.slug}/`)}>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' })}</time>
            <span class="journal-copy"><strong>{post.data.title}</strong><span>{post.data.description}</span></span>
            <span class="journal-arrow" aria-hidden="true">↗</span>
          </a></li>
        ))}</ul> : <p class="journal-empty">New entries coming soon.</p>}
      </div>
    </section>

    <footer class="operator-close"><span>END OF FILE / 001</span><p>The rest is left undocumented.</p></footer>
  </div>
</SiteLayout>

<style>
  .operator-page { --op-ink: #181a1d; --op-muted: #686a6b; --op-rule: rgba(24,26,29,.19); --op-blue: #1648d8; width: 100%; }
  .operator-meta, .operator-subtitle, .art-label, .art-index, .operator-figure figcaption, .section-index, .journal-list time, .journal-arrow, .operator-close > span { font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace; font-size: .66rem; letter-spacing: .075em; text-transform: uppercase; }
  .operator-meta { display:flex; justify-content:space-between; gap:16px; padding: 0 0 13px; border-bottom:1px solid var(--op-rule); color:var(--op-muted); }
  .operator-meta p { margin:0; }
  .operator-meta p:first-child span { color:var(--op-ink); }
  .operator-status { display:flex; align-items:center; gap:9px; }
  .operator-status i { width:7px; height:7px; background:var(--op-blue); }
  .operator-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,.82fr); align-items:center; gap:clamp(28px,7vw,94px); padding:clamp(52px,9vw,110px) 0 clamp(64px,10vw,120px); }
  .operator-copy { max-width:650px; }
  .operator-subtitle { margin:0 0 28px; color:var(--op-blue); }
  .operator-title { margin:0 0 36px -4px; font-size:clamp(3.4rem,8.4vw,7.35rem); font-weight:550; line-height:.91; letter-spacing:-.085em; }
  .operator-title em { color:var(--op-blue); font-style:normal; }
  .operator-body { max-width:560px; color:var(--op-muted); font-size:clamp(.98rem,1.25vw,1.08rem); line-height:1.8; }
  .operator-body p { margin:0 0 17px; }
  .operator-body p:last-child { margin-bottom:0; }
  .operator-figure { width:min(100%,450px); justify-self:end; margin:0; }
  .operator-art-frame { position:relative; aspect-ratio:1; overflow:hidden; border:1px solid var(--op-rule); background:#eae8e1; }
  .operator-art { display:block; width:100%; height:100%; color:var(--op-ink); }
  .operator-axis,.operator-ring,.operator-arc,.operator-vector,.operator-tick { fill:none; stroke:currentColor; }
  .operator-axis { stroke-opacity:.28; stroke-width:1; }
  .operator-ring { stroke-opacity:.35; stroke-width:1; }
  .operator-ring-a { transform-origin:260px 260px; animation:operator-drift 24s linear infinite; }
  .operator-ring-b { stroke-opacity:.22; stroke-dasharray:2 5; }
  .operator-arc { stroke:var(--op-blue); stroke-width:3; }
  .operator-arc-alt { stroke-width:1.5; stroke-dasharray:4 5; }
  .operator-vector { stroke:var(--op-blue); stroke-width:1.5; }
  .operator-core { fill:var(--op-blue); fill-opacity:.1; stroke:var(--op-blue); stroke-width:1; }
  .operator-point { fill:var(--op-blue); }
  .operator-tick { stroke-width:1; stroke-opacity:.55; }
  .art-label,.art-index { position:absolute; color:var(--op-muted); font-size:.56rem; }
  .art-label-top { top:15px; left:15px; }
  .art-label-top span { color:var(--op-ink); }
  .art-label-side { top:15px; right:15px; text-align:right; line-height:1.7; }
  .art-index { right:15px; bottom:14px; color:var(--op-blue); }
  .operator-figure figcaption { display:flex; justify-content:space-between; gap:12px; padding-top:10px; color:var(--op-muted); font-size:.56rem; }
  .operator-journal { display:grid; grid-template-columns:minmax(160px,.6fr) minmax(0,1.4fr); gap:28px; padding:22px 0 30px; border-top:1px solid var(--op-rule); border-bottom:1px solid var(--op-rule); }
  .section-index { margin:5px 0 0; color:var(--op-blue); }
  .section-index span { color:var(--op-muted); }
  .journal-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:10px; }
  .journal-heading h2 { margin:0; font-size:clamp(1.65rem,3vw,2.4rem); font-weight:550; letter-spacing:-.06em; }
  .journal-heading > a { flex:none; color:var(--op-blue); font-size:.78rem; text-decoration:none; }
  .journal-heading > a:hover { text-decoration:underline; text-underline-offset:4px; }
  .journal-list { margin:0; padding:0; list-style:none; }
  .journal-list li { border-top:1px solid var(--op-rule); }
  .journal-row { display:grid; grid-template-columns:78px minmax(0,1fr) 16px; align-items:center; gap:16px; padding:16px 4px; color:inherit; text-decoration:none; transition:padding 180ms ease; }
  .journal-row:hover { padding-right:10px; padding-left:10px; }
  .journal-row:focus-visible { outline:2px solid var(--op-blue); outline-offset:3px; }
  .journal-list time { color:var(--op-muted); font-size:.58rem; }
  .journal-copy { min-width:0; font-size:.96rem; font-weight:500; }
  .journal-copy strong { font:inherit; }
  .journal-copy > span { display:block; margin-top:5px; color:var(--op-muted); font-size:.78rem; font-weight:400; line-height:1.55; }
  .journal-arrow { justify-self:end; color:var(--op-blue); }
  .journal-empty { margin:14px 0 0; color:var(--op-muted); font-size:.92rem; }
  .operator-close { display:flex; justify-content:space-between; align-items:baseline; gap:20px; padding-top:26px; }
  .operator-close > span { color:var(--op-muted); font-size:.59rem; }
  .operator-close p { margin:0; color:var(--op-blue); font-size:clamp(1rem,2vw,1.28rem); letter-spacing:-.03em; }
  .reveal { animation:operator-reveal 700ms both; }
  .reveal-1 { animation-delay:80ms; } .reveal-2 { animation-delay:170ms; } .reveal-3 { animation-delay:270ms; }
  .reveal-geometry { animation:operator-reveal 950ms 160ms both; }
  @keyframes operator-reveal { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
  @keyframes operator-drift { to { transform:rotate(360deg); } }
  @media (max-width:760px) { .operator-hero { grid-template-columns:1fr; gap:38px; padding-top:58px; } .operator-figure { width:min(100%,520px); justify-self:center; } .operator-title { font-size:clamp(3.4rem,12vw,6rem); } }
  @media (max-width:520px) { .operator-meta { align-items:flex-start; font-size:.57rem; } .operator-status { max-width:130px; text-align:right; } .operator-journal { grid-template-columns:1fr; gap:16px; } .journal-heading { align-items:flex-start; flex-direction:column; } .journal-row { grid-template-columns:1fr 16px; gap:8px 12px; } .journal-list time { grid-column:1; } .journal-copy { grid-column:1; } .journal-arrow { grid-column:2; grid-row:1 / span 2; } .operator-close { align-items:flex-start; flex-direction:column; gap:11px; } }
  @media (prefers-reduced-motion:reduce) { .operator-page *, .operator-page *::before, .operator-page *::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; } }
</style>

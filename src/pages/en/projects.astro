---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BakeryBotPreview from '../../components/BakeryBotPreview.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProfistalPreview from '../../components/ProfistalPreview.astro';
import { sitePath } from '../../i18n/paths';
---

<SiteLayout title="Selected work — TRW Studio" description="TRW Studio projects: a website for Profistal14 and a Telegram bot for Pekarnya Chudes bakery." locale="en">
  <div class="projects-page">
    <section class="projects-intro" aria-labelledby="projects-title">
      <p class="projects-kicker reveal reveal-1"><span class="projects-kicker-mark"></span>Selected works <span>/</span> 2026</p>
      <div class="projects-intro-grid">
        <h1 id="projects-title" class="projects-title reveal reveal-2">Selected<br />work<span class="projects-title-period">.</span></h1>
        <div class="projects-intro-copy reveal reveal-3">
          <p>TRW Studio projects present products clearly through thoughtful structure and careful implementation.</p>
          <div class="projects-count" aria-label="Two published case studies">
            <span class="projects-count-number">02</span>
            <span class="projects-count-label">Published<br />case studies</span>
          </div>
        </div>
      </div>
      <div class="projects-intro-foot"><span>A selection of work</span><span>Yakutsk · digital craft</span></div>
    </section>

    <ProjectCard index="02" label="CASE STUDY" type="Telegram bot" client="Пекарня Чудес" title="Pekarnya Chudes." description="A Telegram bot for a bakery, developed to support customer interaction." href={sitePath('/en/projects/pekarnya-chudes/')} linkLabel="Read the case" id="pekarnya-card-title">
      <BakeryBotPreview slot="preview" locale="en" />
    </ProjectCard>

    <ProjectCard index="01" label="CASE STUDY" type="Website · Metalwork" client="Profistal14 — Yakutsk" title="Profistal14." description="A website for a metalwork workshop in Yakutsk, presenting its product areas and helping visitors navigate the categories." href={sitePath('/en/projects/profistal14/')} linkLabel="Read the case" id="profistal-title">
      <ProfistalPreview slot="preview" locale="en" />
    </ProjectCard>

    <section class="projects-outro" aria-label="More from TRW Studio">
      <p class="projects-section-index">02 <span>/ NEXT</span></p>
      <div class="projects-outro-links">
        <a href={sitePath('/en/blog/')}>Notes on the blog <span aria-hidden="true">↗</span></a>
        <a href={sitePath('/en/contact/')}>Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</SiteLayout>

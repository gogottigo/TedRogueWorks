---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="Contact — TedRogueWorks" description="Reach Ted Rogue on Telegram." locale="en">
  <article class="contact-page" aria-labelledby="contact-title">
    <p class="contact-kicker">OPEN CHANNEL <span>/ 001</span></p>
    <div class="contact-grid">
      <h1 id="contact-title">An open<br />channel<span>.</span></h1>
      <div class="contact-message">
        <p>For questions, ideas, or project discussions, reach out on Telegram.</p>
        <a href="https://t.me/gogottigotti" target="_blank" rel="noopener noreferrer">Telegram <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="contact-footer"><span>TED ROGUE / T.R.W.</span><span>CHANNEL 001</span></div>
  </article>
</SiteLayout>

<style>
  .contact-page { --contact-ink:#181a1d; --contact-muted:#686a6b; --contact-rule:rgba(24,26,29,.19); --contact-blue:#1648d8; min-height:clamp(410px,55vh,620px); display:flex; flex-direction:column; justify-content:space-between; }
  .contact-kicker,.contact-footer { font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace; font-size:.67rem; letter-spacing:.075em; }
  .contact-kicker { margin:0; padding-bottom:13px; border-bottom:1px solid var(--contact-rule); color:var(--contact-muted); }
  .contact-kicker span { color:var(--contact-blue); }
  .contact-grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(250px,.85fr); align-items:end; gap:clamp(28px,8vw,110px); padding:clamp(62px,10vw,120px) 0; }
  .contact-grid h1 { margin:0 0 0 -5px; font-size:clamp(5rem,12vw,10rem); font-weight:550; line-height:.82; letter-spacing:-.095em; }
  .contact-grid h1 span { color:var(--contact-blue); }
  .contact-message { max-width:390px; }
  .contact-message p { margin:0; color:var(--contact-muted); font-size:clamp(1rem,1.6vw,1.2rem); line-height:1.7; }
  .contact-message a { display:inline-flex; align-items:center; gap:14px; margin-top:28px; padding:13px 0 10px; border-bottom:1px solid var(--contact-blue); color:var(--contact-blue); font-size:clamp(1.3rem,2.5vw,1.8rem); font-weight:500; letter-spacing:-.045em; text-decoration:none; transition:gap 180ms ease,color 180ms ease; }
  .contact-message a:hover { gap:21px; color:var(--contact-ink); }
  .contact-message a:focus-visible { outline:2px solid var(--contact-blue); outline-offset:5px; }
  .contact-footer { display:flex; justify-content:space-between; gap:18px; padding-top:13px; border-top:1px solid var(--contact-rule); color:var(--contact-muted); }
  @media (max-width:700px) { .contact-page { min-height:clamp(430px,62vh,600px); } .contact-grid { grid-template-columns:1fr; align-items:start; gap:38px; padding:clamp(68px,15vw,100px) 0; } .contact-grid h1 { font-size:clamp(5rem,18vw,8rem); } }
  @media (max-width:420px) { .contact-footer { font-size:.57rem; } }
</style>

---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import BakeryBotPreview from '../../../components/BakeryBotPreview.astro';
import { sitePath } from '../../../i18n/paths';
---

<SiteLayout
  title="Pekarnya Chudes — Telegram bot for a bakery | TRW Studio"
  description="TRW Studio case: a Telegram bot for a bakery, developed to support customer interaction."
  locale="en"
>
  <div class="projects-page">
    <section class="projects-intro" aria-labelledby="projects-title">
      <p class="projects-kicker reveal reveal-1"><span class="projects-kicker-mark"></span>CASE STUDY <span>/ 02</span></p>
      <div class="projects-intro-grid">
        <h1 id="projects-title" class="projects-title reveal reveal-2">Pekarnya<br />Chudes<span class="projects-title-period">.</span></h1>
        <div class="projects-intro-copy reveal reveal-3">
          <p>Telegram bot for a bakery.</p>
          <div class="projects-count" aria-label="Telegram bot for business">
            <span class="projects-count-number">TG</span>
            <span class="projects-count-label">Telegram<br />bot</span>
          </div>
        </div>
      </div>
      <div class="projects-intro-foot"><span>Пекарня Чудес</span><span>Telegram · business bot</span></div>
    </section>

    <section class="project-case" aria-labelledby="case-title">
      <div class="project-case-topline">
        <p class="project-case-index">02 <span>/ CASE STUDY</span></p>
        <p class="project-case-type">Telegram bot</p>
      </div>
      <div class="project-case-grid">
        <div class="project-case-copy">
          <p class="project-client">About the project</p>
          <h2 id="case-title" class="project-case-title">Customer<br /><span>interaction.</span></h2>
          <p class="project-summary">A Telegram bot for a bakery, developed to support customer interaction.</p>
          <dl class="project-facts">
            <div><dt>Category</dt><dd>Telegram bot</dd></div>
            <div><dt>Platform</dt><dd>Telegram</dd></div>
          </dl>
          <a class="project-repo-link project-visit-link" href="https://t.me/PekarnyaChudesBot" target="_blank" rel="noopener noreferrer">Open the bot <span class="project-link-arrow" aria-hidden="true">↗</span></a>
        </div>
        <BakeryBotPreview locale="en" />
      </div>
    </section>

    <section class="projects-outro" aria-label="Project navigation">
      <p class="projects-section-index">02 <span>/ NEXT</span></p>
      <div class="projects-outro-links">
        <a href={sitePath('/en/projects/')}>All projects <span aria-hidden="true">↗</span></a>
        <a href="https://t.me/PekarnyaChudesBot" target="_blank" rel="noopener noreferrer">Open the bot <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .project-case-title { max-width: 100%; font-size: clamp(2.35rem, 4vw, 3.35rem); overflow-wrap: anywhere; }
  @media (max-width: 480px) { .project-case-title { font-size: clamp(2.45rem, 11.5vw, 3.3rem); } }
</style>

---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProfistalPreview from '../../../components/ProfistalPreview.astro';
import { sitePath } from '../../../i18n/paths';
---

<SiteLayout title="Profistal14 — metalwork workshop website | TRW Studio" description="TRW Studio case study: a website for the Profistal14 metalwork workshop in Yakutsk, with a product catalog and inquiry form." locale="en">
  <div class="projects-page">
    <section class="projects-intro" aria-labelledby="projects-title">
      <p class="projects-kicker reveal reveal-1"><span class="projects-kicker-mark"></span>CASE STUDY <span>/ 01</span></p>
      <div class="projects-intro-grid">
        <h1 id="projects-title" class="projects-title reveal reveal-2">Profistal<br />14<span class="projects-title-period">.</span></h1>
        <div class="projects-intro-copy reveal reveal-3">
          <p>A website for a metalwork workshop in Yakutsk.</p>
          <div class="projects-count" aria-label="Corporate website">
            <span class="projects-count-number">WEB</span>
            <span class="projects-count-label">Corporate<br />website</span>
          </div>
        </div>
      </div>
      <div class="projects-intro-foot"><span>Profistal14</span><span>Yakutsk · metalwork</span></div>
    </section>

    <section class="project-case" aria-labelledby="case-title">
      <div class="project-case-topline">
        <p class="project-case-index">01 <span>/ CASE STUDY</span></p>
        <p class="project-case-type">Corporate website</p>
      </div>
      <div class="project-case-grid">
        <div class="project-case-copy">
          <p class="project-client">About the project</p>
          <h2 id="case-title" class="project-case-title case-title">A website for<br />a metalwork<br /><span>workshop.</span></h2>
          <p class="project-summary">The website introduces Profistal14, its product areas and completed work. The catalog helps visitors find a relevant category, and the site includes an inquiry form.</p>
          <dl class="project-facts">
            <div><dt>Category</dt><dd>Corporate website</dd></div>
            <div><dt>Original implementation</dt><dd>Astro · Tailwind CSS</dd></div>
            <div><dt>Original hosting</dt><dd>GitHub Pages</dd></div>
          </dl>
          <div class="project-external-links">
            <a class="project-repo-link project-visit-link" href="https://profistal14.ru/" target="_blank" rel="noopener noreferrer">Visit website <span class="project-link-arrow" aria-hidden="true">↗</span></a>
            <a class="project-repo-link" href="https://github.com/gogottigo/profistal14/" target="_blank" rel="noopener noreferrer">View source on GitHub <span class="project-link-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
        <ProfistalPreview locale="en" />
      </div>
    </section>

    <section class="projects-outro" aria-label="Project navigation">
      <p class="projects-section-index">01 <span>/ NEXT</span></p>
      <div class="projects-outro-links">
        <a href={sitePath('/en/projects/')}>All projects <span aria-hidden="true">↗</span></a>
        <a href="https://profistal14.ru/" target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .case-title { font-size: clamp(2.7rem, 5.6vw, 4.7rem); }
  @media (max-width: 480px) { .case-title { font-size: clamp(2.55rem, 12vw, 3.4rem); } }
</style>

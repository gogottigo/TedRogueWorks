---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { sitePath } from '../../i18n/paths';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ru'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<SiteLayout title="Блог — TedRogueWorks" description="Статьи и заметки о разработке." locale="ru">
  <h1 class="text-5xl font-semibold tracking-tight">Блог</h1>
  <ul class="mt-10 grid gap-5 sm:grid-cols-2">
    {posts.map((post) => (
      <li class="rounded-2xl border border-white/10 p-6">
        <time class="text-sm text-white/50" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ru-RU')}</time>
        <h2 class="mt-3 text-2xl font-medium"><a href={sitePath(`/blog/${post.data.slug}/`)}>{post.data.title}</a></h2>
        <p class="mt-3 text-white/65">{post.data.description}</p>
      </li>
    ))}
  </ul>
</SiteLayout>

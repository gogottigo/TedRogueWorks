---
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../i18n/paths';

const categories = [
  'Мебель в стиле лофт',
  'Мангалы и зоны отдыха',
  'Заборы и ворота',
  'Скамейки и качели',
  'Перила и ограждения',
  'Освещение',
  'Купели',
  'Гаражи',
  'Беседки',
];
---

<SiteLayout title="Проекты — TedRogueWorks" description="Избранная работа: сайт мастерской металлоконструкций ПрофиСталь 14 в Якутске." locale="ru">
  <div class="projects-page">
    <section class="projects-intro" aria-labelledby="projects-title">
      <p class="projects-kicker reveal reveal-1"><span class="projects-kicker-mark"></span>Selected works <span>/</span> 2026</p>
      <div class="projects-intro-grid">
        <h1 id="projects-title" class="projects-title reveal reveal-2">Проекты<span class="projects-title-period">.</span></h1>
        <div class="projects-intro-copy reveal reveal-3">
          <p>Создаю веб-сайты и цифровые инструменты, которые помогают представить продукт ясно и по делу.</p>
          <div class="projects-count" aria-label="Один опубликованный кейс">
            <span class="projects-count-number">01</span>
            <span class="projects-count-label">Опубликованный<br />кейс</span>
          </div>
        </div>
      </div>
      <div class="projects-intro-foot"><span>Подборка работ</span><span>Якутск · цифровая среда</span></div>
    </section>

    <section class="project-case" aria-labelledby="profistal-title">
      <div class="project-case-topline">
        <p class="project-case-index">01 <span>/ КЕЙС</span></p>
        <p class="project-case-type">Веб-сайт · Металлоконструкции</p>
      </div>

      <div class="project-case-grid">
        <div class="project-case-copy">
          <p class="project-client">ПрофиСталь 14 <span>— Якутск</span></p>
          <h2 id="profistal-title" class="project-case-title">Форма,<br />созданная<br /><span>из металла.</span></h2>
          <p class="project-summary">Сайт для мастерской металлоконструкций «ПрофиСталь 14» в Якутске. Структура проекта знакомит с направлениями продукции и помогает сориентироваться в ассортименте.</p>

          <dl class="project-facts">
            <div><dt>Первоначальная реализация</dt><dd>Astro · Tailwind CSS</dd></div>
            <div><dt>Размещение в исходной версии</dt><dd>GitHub Pages</dd></div>
          </dl>
          <div class="project-external-links">
            <a class="project-repo-link project-visit-link" href="https://profistal14.ru/" target="_blank" rel="noopener noreferrer">Открыть сайт ↗</a>
            <a class="project-repo-link" href="https://github.com/gogottigo/profistal14/" target="_blank" rel="noopener noreferrer">Исходный код на GitHub ↗</a>
          </div>
        </div>

        <figure class="project-preview reveal-geometry" aria-label="Абстрактное визуальное превью проекта, не скриншот сайта">
          <div class="preview-canvas">
            <div class="preview-coordinate-grid" aria-hidden="true"></div>
            <div class="preview-caption">PROJECT PREVIEW <span>/ ABSTRACT VISUAL</span></div>
            <svg class="preview-art" viewBox="0 0 640 480" role="img" aria-labelledby="preview-title preview-desc">
              <title id="preview-title">Абстрактная композиция для кейса ПрофиСталь 14</title>
              <desc id="preview-desc">Геометрические формы и линии, вдохновлённые работой с металлом. Это не снимок сайта.</desc>
              <path d="M65 382H575M320 54V428" class="preview-line" />
              <circle cx="320" cy="242" r="152" class="preview-ring" />
              <circle cx="320" cy="242" r="108" class="preview-ring preview-ring-inner" />
              <path d="M320 90A152 152 0 0 1 472 242" class="preview-arc" />
              <path d="M135 338L258 215H448" class="preview-beam" />
              <path d="M258 215V338H448V215" class="preview-frame-line" />
              <rect x="280" y="236" width="80" height="72" class="preview-block" />
              <circle cx="258" cy="215" r="5" class="preview-node" />
              <circle cx="448" cy="215" r="5" class="preview-node" />
              <circle cx="448" cy="338" r="5" class="preview-node" />
            </svg>
            <span class="preview-number">14</span>
            <span class="preview-coordinates">X 320<br />Y 242</span>
            <span class="preview-bottom-label">METAL / FORM / YAKUTSK</span>
          </div>
          <figcaption>Абстрактная композиция, не скриншот сайта.</figcaption>
        </figure>
      </div>

      <div class="project-categories">
        <div class="project-categories-heading"><span>Ассортимент</span><span>09 категорий</span></div>
        <ul>
          {categories.map((category, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{category}</li>)}
        </ul>
      </div>
    </section>

    <section class="projects-outro" aria-label="Другие разделы">
      <p class="projects-section-index">02 <span>/ ДАЛЬШЕ</span></p>
      <div class="projects-outro-links">
        <a href={sitePath('/blog/')}>Заметки в блоге <span aria-hidden="true">↗</span></a>
        <a href={sitePath('/contact/')}>Связаться <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</SiteLayout>

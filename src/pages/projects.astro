---
import SiteLayout from '../layouts/SiteLayout.astro';
import BakeryBotPreview from '../components/BakeryBotPreview.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProfistalPreview from '../components/ProfistalPreview.astro';
import { sitePath } from '../i18n/paths';
---

<SiteLayout title="Проекты — TRW Studio" description="Проекты TRW Studio: сайт мастерской «ПрофиСталь 14» и Telegram-бот для пекарни «Пекарня Чудес»." locale="ru">
  <div class="projects-page">
    <section class="projects-intro" aria-labelledby="projects-title">
      <p class="projects-kicker reveal reveal-1"><span class="projects-kicker-mark"></span>Selected works <span>/</span> 2026</p>
      <div class="projects-intro-grid">
        <h1 id="projects-title" class="projects-title reveal reveal-2">Проекты<span class="projects-title-period">.</span></h1>
        <div class="projects-intro-copy reveal reveal-3">
          <p>Проекты TRW Studio помогают представить продукт ясно и по делу с помощью продуманной структуры и аккуратной реализации.</p>
          <div class="projects-count" aria-label="Два опубликованных кейса">
            <span class="projects-count-number">02</span>
            <span class="projects-count-label">Опубликованных<br />кейса</span>
          </div>
        </div>
      </div>
      <div class="projects-intro-foot"><span>Подборка работ</span><span>Якутск · цифровая среда</span></div>
    </section>

    <ProjectCard index="02" label="КЕЙС" type="Telegram-бот" client="Пекарня Чудес" title="Пекарня Чудес." description="Telegram-бот для пекарни, разработанный для взаимодействия с клиентами." href={sitePath('/projects/pekarnya-chudes/')} linkLabel="Подробный кейс" id="pekarnya-card-title">
      <BakeryBotPreview slot="preview" locale="ru" />
    </ProjectCard>

    <ProjectCard index="01" label="КЕЙС" type="Веб-сайт · Металлоконструкции" client="ПрофиСталь 14 — Якутск" title="ПрофиСталь 14." description="Сайт для мастерской металлоконструкций в Якутске, представляющий направления продукции и помогающий посетителям сориентироваться в категориях." href={sitePath('/projects/profistal14/')} linkLabel="Подробный кейс" id="profistal-title">
      <ProfistalPreview slot="preview" locale="ru" />
    </ProjectCard>

    <section class="projects-outro" aria-label="Другие разделы">
      <p class="projects-section-index">02 <span>/ ДАЛЬШЕ</span></p>
      <div class="projects-outro-links">
        <a href={sitePath('/blog/')}>Заметки в блоге <span aria-hidden="true">↗</span></a>
        <a href={sitePath('/contact/')}>Связаться <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</SiteLayout>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BakeryBotPreview from '../../components/BakeryBotPreview.astro';
import { sitePath } from '../../i18n/paths';
---

<SiteLayout
  title="Пекарня Чудес — Telegram-бот для бизнеса | TRW Studio"
  description="Кейс TRW Studio: Telegram-бот для пекарни, разработанный для взаимодействия с клиентами."
  locale="ru"
>
  <div class="projects-page">
    <section class="projects-intro" aria-labelledby="projects-title">
      <p class="projects-kicker reveal reveal-1"><span class="projects-kicker-mark"></span>CASE STUDY <span>/ 02</span></p>
      <div class="projects-intro-grid">
        <h1 id="projects-title" class="projects-title reveal reveal-2">Пекарня<br />Чудес<span class="projects-title-period">.</span></h1>
        <div class="projects-intro-copy reveal reveal-3">
          <p>Telegram-бот для пекарни.</p>
          <div class="projects-count" aria-label="Telegram-бот для бизнеса">
            <span class="projects-count-number">TG</span>
            <span class="projects-count-label">Telegram<br />бот</span>
          </div>
        </div>
      </div>
      <div class="projects-intro-foot"><span>Пекарня Чудес</span><span>Telegram · бот для бизнеса</span></div>
    </section>

    <section class="project-case" aria-labelledby="case-title">
      <div class="project-case-topline">
        <p class="project-case-index">02 <span>/ КЕЙС</span></p>
        <p class="project-case-type">Telegram-бот</p>
      </div>
      <div class="project-case-grid">
        <div class="project-case-copy">
          <p class="project-client">О проекте</p>
          <h2 id="case-title" class="project-case-title">Взаимодействие<br /><span>с клиентами.</span></h2>
          <p class="project-summary">Telegram-бот для пекарни, разработанный для взаимодействия с клиентами.</p>
          <dl class="project-facts">
            <div><dt>Категория</dt><dd>Telegram-бот</dd></div>
            <div><dt>Платформа</dt><dd>Telegram</dd></div>
          </dl>
          <a class="project-repo-link project-visit-link" href="https://t.me/PekarnyaChudesBot" target="_blank" rel="noopener noreferrer">Открыть бота <span class="project-link-arrow" aria-hidden="true">↗</span></a>
        </div>
        <BakeryBotPreview locale="ru" />
      </div>
    </section>

    <section class="projects-outro" aria-label="Навигация по проектам">
      <p class="projects-section-index">02 <span>/ ДАЛЬШЕ</span></p>
      <div class="projects-outro-links">
        <a href={sitePath('/projects/')}>Все проекты <span aria-hidden="true">↗</span></a>
        <a href="https://t.me/PekarnyaChudesBot" target="_blank" rel="noopener noreferrer">Открыть бота <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .project-case-title { max-width: 100%; font-size: clamp(2.35rem, 4vw, 3.35rem); overflow-wrap: anywhere; }
  @media (max-width: 480px) { .project-case-title { font-size: clamp(2.45rem, 11.5vw, 3.3rem); } }
</style>

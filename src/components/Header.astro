---
import type { Locale } from '../i18n/ui';
import { sitePath, translationPath } from '../i18n/paths';
import { siteConfig } from '../../site.config.mjs';

interface Props {
  locale: Locale;
  translationHref?: string;
}

const { locale, translationHref } = Astro.props;
const root = locale === 'en' ? '/en' : '';
const alternateHref = translationPath(Astro.url.pathname, locale, translationHref);
---

<header class="site-header">
  <a class="site-wordmark" href={sitePath(`${root}/`)} aria-label={`${siteConfig.name} — ${locale === 'ru' ? 'главная' : 'home'}`}>TRW<span> Studio</span></a>
  <button class="nav-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label={locale === 'ru' ? 'Открыть меню' : 'Open menu'} data-open-label={locale === 'ru' ? 'Открыть меню' : 'Open menu'} data-close-label={locale === 'ru' ? 'Закрыть меню' : 'Close menu'}><span class="nav-bars" aria-hidden="true"><i></i><i></i><i></i></span><span>{locale === 'ru' ? 'Меню' : 'Menu'}</span></button>
  <nav id="site-navigation" aria-label={locale === 'ru' ? 'Основная навигация' : 'Main navigation'} class="site-nav">
    <a href={sitePath(`${root}/projects/`)}>{locale === 'ru' ? 'Проекты' : 'Projects'}</a>
    <a href={sitePath(`${root}/#services`)}>{locale === 'ru' ? 'Услуги' : 'Services'}</a>
    <a href={sitePath(`${root}/about/#pricing`)}>{locale === 'ru' ? 'Стоимость' : 'Pricing'}</a>
    <a href={sitePath(`${root}/blog/`)}>{locale === 'ru' ? 'Блог' : 'Journal'}</a>
    <a href={sitePath(`${root}/about/`)}>{locale === 'ru' ? 'Студия' : 'Studio'}</a>
    <a href={sitePath(`${root}/contact/`)}>{locale === 'ru' ? 'Контакты' : 'Contact'}</a>
    <a class="language-link" href={alternateHref} lang={locale === 'ru' ? 'en' : 'ru'} aria-label={locale === 'ru' ? 'Английская версия' : 'Russian version'}>{locale === 'ru' ? 'EN' : 'RU'}</a>
  </nav>
</header>

<style>
  .site-header { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:22px 0; border-bottom:1px solid var(--rule); }
  .site-wordmark { color:var(--ink); font-size:1.05rem; font-weight:650; letter-spacing:-.055em; text-decoration:none; white-space:nowrap; }
  .site-wordmark span { color:var(--muted); font-weight:450; }
  .site-nav { display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-end; gap:10px clamp(14px,2.4vw,30px); color:var(--muted); font-size:.83rem; }
  .site-nav a { text-decoration:none; }
  .site-nav a:hover,.site-nav a:focus-visible { color:var(--cobalt); }
  .site-nav a:focus-visible,.site-wordmark:focus-visible { outline:2px solid var(--cobalt); outline-offset:4px; }
  .site-nav .language-link { color:var(--ink); font-size:.7rem; font-weight:600; letter-spacing:.06em; }
  .nav-toggle { display:none; align-items:center; gap:10px; min-height:44px; padding:8px 10px; color:var(--ink); font:inherit; font-size:.85rem; background:transparent; border:1px solid var(--rule); cursor:pointer; }
  .nav-toggle:focus-visible { outline:2px solid var(--cobalt); outline-offset:3px; }
  .nav-bars { width:17px; display:grid; gap:4px; }
  .nav-bars i { display:block; height:1px; background:currentColor; transition:transform .18s,opacity .18s; }
  [data-menu-open] .nav-bars i:first-child { transform:translateY(5px) rotate(45deg); }
  [data-menu-open] .nav-bars i:nth-child(2) { opacity:0; }
  [data-menu-open] .nav-bars i:last-child { transform:translateY(-5px) rotate(-45deg); }
  @media(max-width:760px) {
    .site-header { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:10px 16px; padding:12px 0; }
    .site-nav { grid-column:1/-1; justify-content:flex-start; gap:0; font-size:.94rem; }
    .site-nav a { display:flex; align-items:center; min-height:44px; padding:8px 12px; }
    .site-header[data-menu-ready] .nav-toggle { display:inline-flex; }
    .site-header[data-menu-ready]:not([data-menu-open]) .site-nav { display:none; }
    .site-header[data-menu-open] .site-nav { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--rule); padding-top:8px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.site-header').forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = header.querySelector<HTMLElement>('.site-nav');
    if (!button || !nav) return;
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-menu-open', open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', (open ? button.dataset.closeLabel : button.dataset.openLabel)!);
    };
    header.dataset.menuReady = '';
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-menu-open')) { setOpen(false); button.focus(); }
    });
    document.addEventListener('click', (event) => { if (!header.contains(event.target as Node)) setOpen(false); });
    window.matchMedia('(min-width:761px)').addEventListener('change', (event) => { if (event.matches) setOpen(false); });
  });
</script>

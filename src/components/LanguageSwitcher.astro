---
import type { Locale } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { translationPath } from '../i18n/paths';

interface Props {
  locale: Locale;
  translationHref?: string;
}

const { locale, translationHref } = Astro.props;
const href = translationPath(Astro.url.pathname, locale, translationHref);
---

<a href={href}>{ui[locale].language}</a>

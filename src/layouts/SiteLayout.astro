---
import Header from '../components/Header.astro';
import type { Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f2ec" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TRW Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="mx-auto min-h-screen w-full max-w-6xl px-5 sm:px-8">
      <Header locale={locale} />
      <main class:list={['pt-10 pb-16 sm:pt-16 sm:pb-24', ['/', '/en/'].includes(Astro.url.pathname) && 'home-main']}>
        <slot />
      </main>
      <footer class="site-footer">
        <a href="/">TRW Studio</a>
        <nav aria-label={locale === 'ru' ? 'Навигация в подвале' : 'Footer navigation'}>
          <a href={locale === 'ru' ? '/projects/' : '/en/projects/'}>{locale === 'ru' ? 'Проекты' : 'Projects'}</a>
          <a href={locale === 'ru' ? '/#services' : '/en/#services'}>{locale === 'ru' ? 'Услуги' : 'Services'}</a>
          <a href={locale === 'ru' ? '/about/' : '/en/about/'}>{locale === 'ru' ? 'Студия' : 'Studio'}</a>
          <a href={locale === 'ru' ? '/contact/' : '/en/contact/'}>{locale === 'ru' ? 'Контакты' : 'Contact'}</a>
          <a href={locale === 'ru' ? '/blog/' : '/en/blog/'}>{locale === 'ru' ? 'Блог' : 'Journal'}</a>
          <a href="https://t.me/gogottigotti" target="_blank" rel="noopener noreferrer">Telegram ↗</a>
        </nav>
        <span>© {new Date().getFullYear()} TRW Studio</span>
      </footer>
    </div>
  </body>
</html>

<style>
  main.home-main { padding-top: clamp(2.875rem, 6.9vw, 4.125rem); }
  .site-footer { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:18px; padding:22px 0; border-top:1px solid var(--rule); color:var(--muted); font-size:.75rem; }
  .site-footer > a { color:var(--ink); font-weight:600; text-decoration:none; }
  .site-footer nav { display:flex; flex-wrap:wrap; gap:10px 18px; }
  .site-footer nav a { text-decoration:none; }
  .site-footer a:hover { color:var(--cobalt); }
  .site-footer a:focus-visible { outline:2px solid var(--cobalt); outline-offset:3px; }
</style>

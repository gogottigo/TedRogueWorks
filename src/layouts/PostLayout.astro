---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import SiteLayout from './SiteLayout.astro';
import type { Locale } from '../i18n/ui';
import { sitePath } from '../i18n/paths';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pubDate: Date;
  translationHref?: string;
}

const { title, description, locale, pubDate, translationHref } = Astro.props;
---

<SiteLayout title={title} description={description} locale={locale} translationHref={translationHref}>
  <article class="post-article mx-auto max-w-3xl">
    <a class="post-back studio-action text-sm text-lime-300" href={sitePath(locale === 'ru' ? '/blog/' : '/en/blog/')}>
      {locale === 'ru' ? '← К блогу' : '← Back to blog'}
    </a>
    <div class="post-meta mt-8 flex flex-wrap items-center justify-between gap-4 text-sm text-white/50">
      <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString(locale === 'ru' ? 'ru-RU' : 'en-US')}</time>
      <LanguageSwitcher locale={locale} translationHref={translationHref} />
    </div>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">{title}</h1>
    <p class="mt-5 text-lg text-white/65">{description}</p>
    <div class="post-content mt-12 max-w-none leading-8 [&_a]:text-lime-300 [&_h2]:mb-3 [&_h2]:mt-10 [&_h2]:text-3xl [&_p]:my-5">
      <slot />
    </div>
  </article>
</SiteLayout>

<style>
.post-article{min-width:0}.post-content{overflow-wrap:anywhere;line-height:1.8}.post-content :global(pre){max-width:100%;overflow-x:auto;overscroll-behavior-x:contain;padding:16px;border:1px solid var(--rule);font-size:.85rem;line-height:1.7;scrollbar-gutter:stable}
.post-content :global(pre:focus-visible){outline:2px solid var(--cobalt);outline-offset:3px}.post-content :global(pre code){white-space:pre;overflow-wrap:normal;word-break:normal}
.post-content :global(ul),.post-content :global(ol){padding-left:24px}.post-content :global(li){margin-block:8px}.post-meta :global(a){display:inline-flex;align-items:center;min-height:44px;min-width:44px}
@media(max-width:540px){.post-article h1{font-size:clamp(2rem,9vw,2.8rem);line-height:1.15;letter-spacing:-.04em}.post-content{margin-top:32px}.post-content :global(pre){padding:12px}}
</style>

---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import SiteLayout from './SiteLayout.astro';
import type { Locale } from '../i18n/ui';
import { sitePath } from '../i18n/paths';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pubDate: Date;
  translationHref?: string;
}

const { title, description, locale, pubDate, translationHref } = Astro.props;
---

<SiteLayout title={title} description={description} locale={locale}>
  <article class="mx-auto max-w-3xl">
    <a class="text-sm text-lime-300" href={sitePath(locale === 'ru' ? '/blog/' : '/en/blog/')}>
      {locale === 'ru' ? '← К блогу' : '← Back to blog'}
    </a>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 text-sm text-white/50">
      <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString(locale === 'ru' ? 'ru-RU' : 'en-US')}</time>
      <LanguageSwitcher locale={locale} translationHref={translationHref} />
    </div>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">{title}</h1>
    <p class="mt-5 text-lg text-white/65">{description}</p>
    <div class="mt-12 max-w-none leading-8 [&_a]:text-lime-300 [&_h2]:mb-3 [&_h2]:mt-10 [&_h2]:text-3xl [&_p]:my-5">
      <slot />
    </div>
  </article>
</SiteLayout>
